# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/breather
# For Atlas: MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/breather

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ── Client ───────────────────────────────────────────
CLIENT_URL=http://localhost:3000
